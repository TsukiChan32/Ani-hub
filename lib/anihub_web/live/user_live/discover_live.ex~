defmodule AnihubWeb.DiscoverLive do
  use AnihubWeb, :live_view

  alias Anihub.Anilist

  @sorts ["trending", "popular", "score"]
  @seasons ["WINTER", "SPRING", "SUMMER", "FALL"]

  @impl true
  def mount(_params, _session, socket) do
    genres =
      case Anilist.genres() do
        {:ok, genres} -> genres
        {:error, _reason} -> []
      end

    {:ok,
     socket
     |> assign(:genres, genres)
     |> assign(:anime, [])
     |> assign(:page_info, %{})
     |> assign(:discover_error, false)
     |> assign(:filters, default_filters())}
  end

  @impl true
  def handle_params(params, _uri, socket) do
    filters =
      params
      |> normalize_filters()

    case Anilist.discover(filters) do
      {:ok, %{anime: anime, page_info: page_info}} ->
        {:noreply,
         socket
         |> assign(:filters, filters)
         |> assign(:anime, anime)
         |> assign(:page_info, page_info)
         |> assign(:discover_error, false)}

      {:error, _reason} ->
        {:noreply,
         socket
         |> assign(:filters, filters)
         |> assign(:anime, [])
         |> assign(:page_info, %{})
         |> assign(:discover_error, true)}
    end
  end

  # --------------------------------------------------
  # FILTERS
  # --------------------------------------------------

  defp normalize_filters(params) do
    defaults = default_filters()

    %{
      "season" => normalize_season(Map.get(params, "season", defaults["season"])),
      "year" => normalize_year(Map.get(params, "year", defaults["year"])),
      "genre" => normalize_genre(Map.get(params, "genre", "")),
      "sort" => normalize_sort(Map.get(params, "sort", "trending")),
      "page" => normalize_page(Map.get(params, "page", "1"))
    }
  end

  defp default_filters do
    today = Date.utc_today()

    %{
      "season" => current_season(today),
      "year" => Integer.to_string(today.year),
      "genre" => "",
      "sort" => "trending",
      "page" => 1
    }
  end

  defp current_season(%Date{month: month})
       when month in [1, 2, 3],
       do: "WINTER"

  defp current_season(%Date{month: month})
       when month in [4, 5, 6],
       do: "SPRING"

  defp current_season(%Date{month: month})
       when month in [7, 8, 9],
       do: "SUMMER"

  defp current_season(_date),
    do: "FALL"

  defp normalize_season(season)
       when season in @seasons,
       do: season

  defp normalize_season(_),
    do: nil

  defp normalize_year(year) when is_integer(year),
    do: year

  defp normalize_year(year) when is_binary(year) do
    case Integer.parse(year) do
      {year, ""} when year >= 1900 and year <= 2100 ->
        year

      _ ->
        Date.utc_today().year
    end
  end

  defp normalize_year(_),
    do: Date.utc_today().year

  defp normalize_genre(nil), do: ""
  defp normalize_genre(""), do: ""

  defp normalize_genre(genre) when is_binary(genre),
    do: String.trim(genre)

  defp normalize_genre(_),
    do: ""

  defp normalize_sort(sort)
       when sort in @sorts,
       do: sort

  defp normalize_sort(_),
    do: "trending"

  defp normalize_page(page)
       when is_integer(page) and page > 0,
       do: page

  defp normalize_page(page) when is_binary(page) do
    case Integer.parse(page) do
      {page, ""} when page > 0 -> page
      _ -> 1
    end
  end

  defp normalize_page(_),
    do: 1

  # --------------------------------------------------
  # URL HELPERS
  # --------------------------------------------------

  defp discover_path(filters, overrides \\ %{}) do
    params =
      filters
      |> Map.merge(overrides)
      |> Enum.reject(fn
        {"genre", ""} -> true
        {_key, nil} -> true
        _ -> false
      end)
      |> Map.new()
      |> Enum.map(fn {key, value} ->
        {key, to_string(value)}
      end)
      |> Map.new()

    "/discover?" <> URI.encode_query(params)
  end

  # --------------------------------------------------
  # DISPLAY HELPERS
  # --------------------------------------------------

  defp season_label(nil), do: "Any season"

  defp season_label(season) do
    season
    |> String.downcase()
    |> String.capitalize()
  end

  defp format_label(nil), do: "—"
  defp format_label("TV"), do: "TV"
  defp format_label("TV_SHORT"), do: "TV Short"
  defp format_label("MOVIE"), do: "Movie"
  defp format_label("OVA"), do: "OVA"
  defp format_label("ONA"), do: "ONA"
  defp format_label("SPECIAL"), do: "Special"
  defp format_label("MUSIC"), do: "Music"

  defp format_label(format) do
    format
    |> String.replace("_", " ")
    |> String.downcase()
    |> String.capitalize()
  end
end
