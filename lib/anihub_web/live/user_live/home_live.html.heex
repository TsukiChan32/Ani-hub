<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <.app_nav current={:home} current_scope={@current_scope} />

  <%!-- Search --%>
  <div class="relative z-50 mb-10">
    <.live_component module={AnihubWeb.SearchComponent} id="home-search" />
  </div>

  <%!-- Hero --%>
  <%= if @hero do %>
    <section class="mb-12 overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--surface)]">
      <div class="grid items-stretch lg:grid-cols-[55%_45%]">
        <div class="flex flex-col justify-center px-6 py-10 sm:px-8 lg:px-10">
          <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
            Trending #1
          </p>

          <h1 class="mt-2 text-4xl font-bold tracking-tight text-[var(--text)] sm:text-5xl">
            {@hero["title"]["english"] || @hero["title"]["romaji"]}
          </h1>

          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--text-muted)]">
            <%= if @hero["averageScore"] do %>
              <span>
                Score:
                <strong class="font-semibold text-[var(--text)]">
                  {@hero["averageScore"]}%
                </strong>
              </span>
            <% end %>

            <%= if @hero["episodes"] do %>
              <span>
                Episodes:
                <strong class="font-semibold text-[var(--text)]">
                  {@hero["episodes"]}
                </strong>
              </span>
            <% end %>

            <%= if @hero["seasonYear"] do %>
              <span>
                Year:
                <strong class="font-semibold text-[var(--text)]">
                  {@hero["seasonYear"]}
                </strong>
              </span>
            <% end %>
          </div>

          <%= if @hero["description"] do %>
            <div class="mt-5 line-clamp-4 max-w-2xl text-sm leading-7 text-[var(--text-muted)] sm:text-base">
              {Phoenix.HTML.raw(@hero["description"])}
            </div>
          <% end %>

          <div class="mt-7">
            <.link
              navigate={~p"/anime/#{@hero["id"]}"}
              class="inline-flex items-center gap-2 rounded-xl bg-[var(--accent)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]"
            >
              View anime <.icon name="hero-arrow-right" class="size-4" />
            </.link>
          </div>
        </div>

        <div class="relative min-h-[320px] lg:min-h-[400px]">
          <%= if @hero["bannerImage"] do %>
            <img
              src={@hero["bannerImage"]}
              alt={@hero["title"]["english"] || @hero["title"]["romaji"]}
              class="absolute inset-0 h-full w-full object-cover object-center"
            />
          <% else %>
            <img
              src={@hero["coverImage"]["large"]}
              alt={@hero["title"]["english"] || @hero["title"]["romaji"]}
              class="absolute inset-0 h-full w-full object-cover object-center"
            />
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <%!-- Currently watching --%>
  <%= if @watching !=[] do %>
    <section class="mb-14">
      <div class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
          Your Library
        </p>

        <h2 class="mt-1 text-2xl font-bold tracking-tight text-[var(--text)]">
          Currently watching
        </h2>

        <p class="mt-2 text-sm text-[var(--text-muted)]">
          Keep track of your current series.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <%= for item <- @watching do %>
          <.link
            navigate={~p"/anime/#{item.anime["id"]}"}
            class="group flex gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-3 transition-colors hover:bg-[var(--surface-hover)]"
          >
            <img
              src={item.anime["coverImage"]["large"]}
              alt={
                item.anime["title"]["english"] ||
                  item.anime["title"]["romaji"]
              }
              class="h-28 w-20 shrink-0 rounded-xl object-cover"
            />

            <div class="flex min-w-0 flex-1 flex-col justify-center">
              <h3 class="line-clamp-2 font-semibold text-[var(--text)] transition-colors group-hover:text-[var(--accent)]">
                {item.anime["title"]["english"] || item.anime["title"]["romaji"]}
              </h3>

              <div class="mt-3">
                <div class="flex items-center justify-between gap-3 text-sm">
                  <span class="text-[var(--text-muted)]">
                    Progress
                  </span>

                  <span class="font-semibold text-[var(--text)]">
                    {progress_value(item.entry.progress)}/{item.anime["episodes"] || "?"}
                  </span>
                </div>

                <%= if is_integer(item.anime["episodes"]) && item.anime["episodes"]> 0 do %>
                  <progress
                    value={progress_value(item.entry.progress)}
                    max={item.anime["episodes"]}
                    class="mt-2 h-2 w-full overflow-hidden rounded-full accent-[var(--accent)]"
                  >
                    {progress_value(item.entry.progress)}
                  </progress>
                <% end %>
              </div>

              <div class="mt-3 flex items-center gap-2 text-sm font-medium text-[var(--accent)]">
                <span>Watching</span>
                <.icon name="hero-arrow-right" class="size-4" />
              </div>
            </div>
          </.link>
        <% end %>
      </div>
    </section>
  <% end %>

  <%!-- Trending --%>
  <section>
    <div class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
        Discover
      </p>

      <h2 class="mt-1 text-3xl font-bold tracking-tight text-[var(--text)]">
        Trending now
      </h2>

      <p class="mt-2 text-sm text-[var(--text-muted)]">
        Popular anime on AniList right now.
      </p>
    </div>

    <%= if @anime==[] do %>
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center text-[var(--text-muted)]">
        Nothing to show right now.
      </div>
    <% else %>
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        <%= for anime <- @anime do %>
          <.link navigate={~p"/anime/#{anime["id"]}"} class="group block min-w-0">
            <div class="overflow-hidden rounded-2xl bg-[var(--surface)]">
              <img
                src={anime["coverImage"]["large"]}
                alt={
                  anime["title"]["english"] ||
                    anime["title"]["romaji"]
                }
                class="aspect-[2/3] w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
              />
            </div>

            <div class="mt-3">
              <h3 class="truncate font-semibold text-[var(--text)] transition-colors group-hover:text-[var(--accent)]">
                {anime["title"]["english"] || anime["title"]["romaji"]}
              </h3>

              <div class="mt-1 flex items-center gap-2 text-sm text-[var(--text-muted)]">
                <%= if anime["averageScore"] do %>
                  <span>
                    {anime["averageScore"]}%
                  </span>
                <% end %>

                <%= if anime["seasonYear"] do %>
                  <span class="text-[var(--border)]">
                    •
                  </span>

                  <span>
                    {anime["seasonYear"]}
                  </span>
                <% end %>
              </div>
            </div>
          </.link>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
