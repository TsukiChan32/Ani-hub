<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <%!-- Navigation --%>
  <.app_nav current={:home} />

  <%!-- Live search --%>
  <div class="relative z-50 mb-12">
    <.live_component module={AnihubWeb.SearchComponent} id="home-search" />
  </div>

  <%!-- Trending --%>
  <section>
    <div class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
        Discover
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-[var(--text)]">
        Trending now
      </h1>

      <p class="mt-2 text-sm text-[var(--text-muted)]">
        Popular anime on AniList right now.
      </p>
    </div>

    <%= if @anime==[] do %>
      <div class="
        rounded-2xl
        border border-[var(--border)]
        bg-[var(--surface)]
        p-8
        text-center
        text-[var(--text-muted)]
      ">
        Nothing to show right now.
      </div>
    <% else %>
      <div class="
        grid grid-cols-2
        gap-x-4 gap-y-8
        sm:grid-cols-3
        md:grid-cols-4
        lg:grid-cols-5
      ">
        <%= for anime <- @anime do %>
          <.link navigate={~p"/anime/#{anime["id"]}"} class="group block min-w-0">
            <div class="
              overflow-hidden
              rounded-2xl
              bg-[var(--surface)]
            ">
              <img
                src={anime["coverImage"]["large"]}
                alt={
                  anime["title"]["english"] ||
                    anime["title"]["romaji"]
                }
                class="
                  aspect-[2/3]
                  w-full
                  object-cover
                  transition-transform
                  duration-200
                  group-hover:scale-[1.02]
                "
              />
            </div>

            <div class="mt-3">
              <h2 class="
                truncate
                font-semibold
                text-[var(--text)]
                transition-colors
                group-hover:text-[var(--accent)]
              ">
                {anime["title"]["english"] || anime["title"]["romaji"]}
              </h2>

              <div class="mt-1 flex items-center gap-2 text-sm text-[var(--text-muted)]">
                <%= if anime["averageScore"] do %>
                  <span>
                    {anime["averageScore"]}%
                  </span>
                <% end %>

                <%= if anime["seasonYear"] do %>
                  <span class="text-[var(--border)]">•</span>
                  <span>
                    {anime["seasonYear"]}
                  </span>
                <% end %>
              </div>
            </div>
          </.link>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
