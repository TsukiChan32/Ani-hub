<div class="mx-auto max-w-6xl px-3 py-5 sm:px-4">
  <.app_nav current={:home} current_scope={@current_scope} />

  <%!-- Search --%>
  <div class="relative z-50 mb-5 border border-[var(--border)] bg-[var(--surface)] p-2">
    <.live_component module={AnihubWeb.SearchComponent} id="home-search" />
  </div>

  <%!-- Featured anime --%>
  <%= if @hero do %>
    <section class="mb-6 border border-[var(--border)] bg-[var(--surface)]">
      <div class="old-panel-header px-3 py-2">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
            Featured anime
          </h2>

          <span class="text-xs font-semibold text-[var(--accent)]">
            Trending #1
          </span>
        </div>
      </div>

      <div class="grid gap-0 md:grid-cols-[180px_minmax(0,1fr)]">
        <div class="border-b border-[var(--border)] p-3 md:border-b-0 md:border-r">
          <%= if @hero["coverImage"]["large"] do %>
            <img
              src={@hero["coverImage"]["large"]}
              alt={@hero["title"]["english"] || @hero["title"]["romaji"]}
              class="mx-auto aspect-[2/3] w-full max-w-[180px] border border-[var(--border)] object-cover"
            />
          <% end %>
        </div>

        <div class="min-w-0 p-4">
          <h1 class="text-2xl font-bold leading-tight text-[var(--text)] sm:text-3xl">
            <.link
              navigate={~p"/anime/#{@hero["id"]}"}
              class="text-[var(--accent)] hover:underline"
            >
              {@hero["title"]["english"] || @hero["title"]["romaji"]}
            </.link>
          </h1>

          <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 border-y border-[var(--border)] py-2 text-sm">
            <%= if @hero["averageScore"] do %>
              <span>
                <span class="text-[var(--text-muted)]">Score:</span>
                <strong class="text-[var(--text)]">
                  {@hero["averageScore"]}%
                </strong>
              </span>
            <% end %>

            <%= if @hero["episodes"] do %>
              <span>
                <span class="text-[var(--text-muted)]">Episodes:</span>
                <strong class="text-[var(--text)]">
                  {@hero["episodes"]}
                </strong>
              </span>
            <% end %>

            <%= if @hero["seasonYear"] do %>
              <span>
                <span class="text-[var(--text-muted)]">Year:</span>
                <strong class="text-[var(--text)]">
                  {@hero["seasonYear"]}
                </strong>
              </span>
            <% end %>
          </div>

          <%= if @hero["description"] do %>
            <div class="mt-4 line-clamp-6 max-w-3xl text-sm leading-6 text-[var(--text-muted)]">
              {Phoenix.HTML.raw(@hero["description"])}
            </div>
          <% end %>

          <div class="mt-4">
            <.link
              navigate={~p"/anime/#{@hero["id"]}"}
              class="old-button"
            >
              View anime →
            </.link>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <%!-- Currently watching --%>
  <%= if @watching != [] do %>
    <section class="mb-6 border border-[var(--border)] bg-[var(--surface)]">
      <div class="old-panel-header px-3 py-2">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
              Currently watching
            </h2>

            <p class="mt-0.5 text-xs text-[var(--text-muted)]">
              Your active library entries
            </p>
          </div>

          <.link
            navigate={~p"/library"}
            class="text-xs font-medium text-[var(--accent)] hover:underline"
          >
            View library
          </.link>
        </div>
      </div>

      <div class="divide-y divide-[var(--border)]">
        <%= for item <- @watching do %>
          <.link
            navigate={~p"/anime/#{item.anime["id"]}"}
            class="group grid grid-cols-[56px_minmax(0,1fr)] gap-3 p-3 hover:bg-[var(--surface-hover)] sm:grid-cols-[64px_minmax(0,1fr)_180px]"
          >
            <img
              src={item.anime["coverImage"]["large"]}
              alt={
                item.anime["title"]["english"] ||
                  item.anime["title"]["romaji"]
              }
              class="aspect-[2/3] w-full border border-[var(--border)] object-cover"
            />

            <div class="min-w-0">
              <h3 class="truncate text-sm font-bold text-[var(--accent)] group-hover:underline">
                {item.anime["title"]["english"] || item.anime["title"]["romaji"]}
              </h3>

              <div class="mt-1 text-xs text-[var(--text-muted)]">
                Watching
              </div>

              <div class="mt-2 text-xs text-[var(--text-muted)] sm:hidden">
                Progress:
                <strong class="text-[var(--text)]">
                  {progress_value(item.entry.progress)}/{item.anime["episodes"] || "?"}
                </strong>
              </div>
            </div>

            <div class="hidden min-w-0 self-center sm:block">
              <div class="flex items-center justify-between gap-3 text-xs">
                <span class="text-[var(--text-muted)]">
                  Progress
                </span>

                <strong class="text-[var(--text)]">
                  {progress_value(item.entry.progress)}/{item.anime["episodes"] || "?"}
                </strong>
              </div>

              <%= if is_integer(item.anime["episodes"]) && item.anime["episodes"] > 0 do %>
                <progress
                  value={progress_value(item.entry.progress)}
                  max={item.anime["episodes"]}
                  class="mt-1 w-full"
                >
                  {progress_value(item.entry.progress)}
                </progress>
              <% end %>
            </div>
          </.link>
        <% end %>
      </div>
    </section>
  <% end %>

  <%!-- Trending --%>
  <section class="border border-[var(--border)] bg-[var(--surface)]">
    <div class="old-panel-header px-3 py-2">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
            Trending now
          </h2>

          <p class="mt-0.5 text-xs text-[var(--text-muted)]">
            Popular anime on AniList
          </p>
        </div>

        <span class="text-xs text-[var(--text-muted)]">
          {length(@anime)} titles
        </span>
      </div>
    </div>

    <%= if @anime == [] do %>
      <div class="p-6 text-center text-sm text-[var(--text-muted)]">
        Nothing to show right now.
      </div>
    <% else %>
      <div class="divide-y divide-[var(--border)]">
        <%= for anime <- @anime do %>
          <.link
            navigate={~p"/anime/#{anime["id"]}"}
            class="group grid grid-cols-[52px_minmax(0,1fr)] gap-3 p-3 hover:bg-[var(--surface-hover)] sm:grid-cols-[60px_minmax(0,1fr)_90px_90px]"
          >
            <img
              src={anime["coverImage"]["large"]}
              alt={
                anime["title"]["english"] ||
                  anime["title"]["romaji"]
              }
              class="aspect-[2/3] w-full border border-[var(--border)] object-cover"
            />

            <div class="min-w-0 self-center">
              <h3 class="truncate text-sm font-bold text-[var(--accent)] group-hover:underline">
                {anime["title"]["english"] || anime["title"]["romaji"]}
              </h3>

              <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-[var(--text-muted)] sm:hidden">
                <%= if anime["averageScore"] do %>
                  <span>
                    {anime["averageScore"]}%
                  </span>
                <% end %>

                <%= if anime["seasonYear"] do %>
                  <span>
                    {anime["seasonYear"]}
                  </span>
                <% end %>
              </div>
            </div>

            <div class="hidden self-center text-right text-xs sm:block">
              <div class="text-[var(--text-muted)]">
                Score
              </div>

              <div class="mt-0.5 font-semibold text-[var(--text)]">
                <%= if anime["averageScore"] do %>
                  {anime["averageScore"]}%
                <% else %>
                  —
                <% end %>
              </div>
            </div>

            <div class="hidden self-center text-right text-xs sm:block">
              <div class="text-[var(--text-muted)]">
                Year
              </div>

              <div class="mt-0.5 font-semibold text-[var(--text)]">
                {anime["seasonYear"] || "—"}
              </div>
            </div>
          </.link>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
