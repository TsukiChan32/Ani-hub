<div class="mx-auto max-w-6xl px-3 py-5 sm:px-4">
  <.app_nav current={:discover} current_scope={@current_scope} />

  <%!-- Search --%>
  <div class="relative z-50 mb-5 border border-[var(--border)] bg-[var(--surface)] p-2">
    <.live_component
      module={AnihubWeb.SearchComponent}
      id="discover-search"
    />
  </div>

  <%!-- Breadcrumb --%>
  <div class="mb-3 text-xs text-[var(--text-muted)]">
    <.link
      navigate={~p"/"}
      class="text-[var(--accent)] hover:underline"
    >
      Home
    </.link>

    <span class="mx-1">»</span>

    <span class="text-[var(--text)]">
      Discover
    </span>
  </div>

  <%!-- Main panel --%>
  <section class="border border-[var(--border)] bg-[var(--surface)]">
    <div class="old-panel-header px-3 py-2">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
            Discover anime
          </h1>

          <p class="mt-0.5 text-xs text-[var(--text-muted)]">
            Browse anime by season, year, genre and ranking.
          </p>
        </div>

        <%= if @page_info["total"] do %>
          <span class="text-xs text-[var(--text-muted)]">
            {@page_info["total"]} titles
          </span>
        <% end %>
      </div>
    </div>

    <%!-- Filters --%>
    <form
      action="/discover"
      method="get"
      class="border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-3"
    >
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_100px_1fr_1fr_auto] lg:items-end">
        <%!-- Season --%>
        <div>
          <label
            for="discover-season"
            class="mb-1 block text-xs font-bold uppercase text-[var(--text-muted)]"
          >
            Season
          </label>

          <select
            id="discover-season"
            name="season"
            class="w-full border border-[var(--border)] bg-[var(--surface)] px-2 py-1.5 text-sm text-[var(--text)] outline-none focus:border-[var(--accent)]"
          >
            <%= for season <- @seasons do %>
              <option
                value={season}
                selected={@filters["season"] == season}
              >
                {season_label(season)}
              </option>
            <% end %>
          </select>
        </div>

        <%!-- Year --%>
        <div>
          <label
            for="discover-year"
            class="mb-1 block text-xs font-bold uppercase text-[var(--text-muted)]"
          >
            Year
          </label>

          <input
            id="discover-year"
            name="year"
            type="number"
            min="1900"
            max="2100"
            value={@filters["year"]}
            class="w-full border border-[var(--border)] bg-[var(--surface)] px-2 py-1.5 text-sm text-[var(--text)] outline-none focus:border-[var(--accent)]"
          />
        </div>

        <%!-- Genre --%>
        <div>
          <label
            for="discover-genre"
            class="mb-1 block text-xs font-bold uppercase text-[var(--text-muted)]"
          >
            Genre
          </label>

          <select
            id="discover-genre"
            name="genre"
            class="w-full border border-[var(--border)] bg-[var(--surface)] px-2 py-1.5 text-sm text-[var(--text)] outline-none focus:border-[var(--accent)]"
          >
            <option value="">
              All genres
            </option>

            <%= for genre <- @genres do %>
              <option
                value={genre}
                selected={@filters["genre"] == genre}
              >
                {genre}
              </option>
            <% end %>
          </select>
        </div>

        <%!-- Sort --%>
        <div>
          <label
            for="discover-sort"
            class="mb-1 block text-xs font-bold uppercase text-[var(--text-muted)]"
          >
            Sort by
          </label>

          <select
            id="discover-sort"
            name="sort"
            class="w-full border border-[var(--border)] bg-[var(--surface)] px-2 py-1.5 text-sm text-[var(--text)] outline-none focus:border-[var(--accent)]"
          >
            <option
              value="trending"
              selected={@filters["sort"] == "trending"}
            >
              Trending
            </option>

            <option
              value="popular"
              selected={@filters["sort"] == "popular"}
            >
              Popularity
            </option>

            <option
              value="score"
              selected={@filters["sort"] == "score"}
            >
              Score
            </option>
          </select>
        </div>

        <div>
          <button
            type="submit"
            class="old-button whitespace-nowrap"
          >
            Apply filters →
          </button>
        </div>
      </div>
    </form>

    <%!-- Active filters --%>
    <div class="border-b border-[var(--border)] px-3 py-2 text-xs text-[var(--text-muted)]">
      Showing:
      <strong class="text-[var(--text)]">
        {season_label(@filters["season"])}
        {@filters["year"]}
      </strong>

      <%= if @filters["genre"] != "" do %>
        <span class="mx-1">•</span>
        Genre:
        <strong class="text-[var(--text)]">
          {@filters["genre"]}
        </strong>
      <% end %>

      <span class="mx-1">•</span>
      Sort:
      <strong class="text-[var(--text)]">
        {String.capitalize(@filters["sort"])}
      </strong>
    </div>

    <%= cond do %>
      <% @discover_error -> %>
        <div class="px-3 py-8 text-center">
          <p class="text-sm font-semibold text-[var(--text)]">
            Could not load anime.
          </p>

          <p class="mt-1 text-sm text-[var(--text-muted)]">
            AniList may be temporarily unavailable.
          </p>
        </div>
      <% @anime == [] -> %>
        <div class="px-3 py-8 text-center text-sm text-[var(--text-muted)]">
          No anime matched these filters.
        </div>
      <% true -> %>
        <%!-- Table header --%>
        <div class="hidden grid-cols-[58px_minmax(0,1fr)_80px_80px_80px_90px] border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-1.5 text-xs font-bold uppercase text-[var(--text-muted)] sm:grid">
          <div>Cover</div>
          <div>Title</div>
          <div class="text-right">Score</div>
          <div class="text-right">Episodes</div>
          <div class="text-right">Type</div>
          <div class="text-right">Year</div>
        </div>

        <div class="divide-y divide-[var(--border)]">
          <%= for anime <- @anime do %>
            <.link
              navigate={~p"/anime/#{anime["id"]}"}
              class="group grid grid-cols-[58px_minmax(0,1fr)] gap-3 px-3 py-2 hover:bg-[var(--surface-hover)] sm:grid-cols-[58px_minmax(0,1fr)_80px_80px_80px_90px]"
            >
              <img
                src={anime["coverImage"]["large"]}
                alt={
                  anime["title"]["english"] ||
                    anime["title"]["romaji"]
                }
                class="h-20 w-14 border border-[var(--border)] object-cover"
              />

              <div class="min-w-0 self-center">
                <h2 class="truncate text-sm font-bold text-[var(--accent)] group-hover:underline">
                  {anime["title"]["english"] || anime["title"]["romaji"]}
                </h2>

                <%= if anime["title"]["english"] &&
                      anime["title"]["romaji"] &&
                      anime["title"]["english"] != anime["title"]["romaji"] do %>
                  <p class="mt-0.5 truncate text-xs text-[var(--text-muted)]">
                    {anime["title"]["romaji"]}
                  </p>
                <% end %>

                <div class="mt-1 flex flex-wrap gap-x-2 text-xs text-[var(--text-muted)] sm:hidden">
                  <span>
                    {anime["averageScore"] || "—"}%
                  </span>

                  <span>
                    {anime["episodes"] || "?"} eps
                  </span>

                  <span>
                    {format_label(anime["format"])}
                  </span>

                  <span>
                    {anime["seasonYear"] || "—"}
                  </span>
                </div>
              </div>

              <div class="hidden self-center text-right text-xs sm:block">
                <%= if anime["averageScore"] do %>
                  <strong class="text-[var(--text)]">
                    {anime["averageScore"]}%
                  </strong>
                <% else %>
                  <span class="text-[var(--text-muted)]">—</span>
                <% end %>
              </div>

              <div class="hidden self-center text-right text-xs sm:block">
                <strong class="text-[var(--text)]">
                  {anime["episodes"] || "?"}
                </strong>
              </div>

              <div class="hidden self-center text-right text-xs sm:block">
                {format_label(anime["format"])}
              </div>

              <div class="hidden self-center text-right text-xs sm:block">
                <strong class="text-[var(--text)]">
                  {anime["seasonYear"] || "—"}
                </strong>
              </div>
            </.link>
          <% end %>
        </div>

        <%!-- Pagination --%>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border)] bg-[var(--surface-hover)] px-3 py-2 text-sm">
          <div>
            <%= if @page_info["currentPage"] && @page_info["currentPage"] > 1 do %>
              <.link
                patch={
                  discover_path(
                    @filters,
                    %{"page" => @page_info["currentPage"] - 1}
                  )
                }
                class="font-semibold text-[var(--accent)] hover:underline"
              >
                « Previous
              </.link>
            <% else %>
              <span class="text-[var(--text-muted)]">
                « Previous
              </span>
            <% end %>
          </div>

          <div class="text-xs text-[var(--text-muted)]">
            Page
            <strong class="text-[var(--text)]">
              {@page_info["currentPage"] || @filters["page"]}
            </strong>

            <%= if @page_info["lastPage"] do %>
              of
              <strong class="text-[var(--text)]">
                {@page_info["lastPage"]}
              </strong>
            <% end %>
          </div>

          <div>
            <%= if @page_info["hasNextPage"] do %>
              <.link
                patch={
                  discover_path(
                    @filters,
                    %{"page" => (@page_info["currentPage"] || 1) + 1}
                  )
                }
                class="font-semibold text-[var(--accent)] hover:underline"
              >
                Next »
              </.link>
            <% else %>
              <span class="text-[var(--text-muted)]">
                Next »
              </span>
            <% end %>
          </div>
        </div>
    <% end %>
  </section>
</div>
