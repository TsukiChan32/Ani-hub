<div
  id="release-calendar"
  phx-hook="LocalCalendar"
  data-week-start={Date.to_iso8601(@week_start)}
  class="mx-auto max-w-6xl px-3 py-5 sm:px-4"
>
  <.app_nav current={:calendar} current_scope={@current_scope} />

  <%!-- Search --%>
  <div class="relative z-50 mb-5 border border-[var(--border)] bg-[var(--surface)] p-2">
    <.live_component
      module={AnihubWeb.SearchComponent}
      id="calendar-search"
    />
  </div>

  <%!-- Breadcrumb --%>
  <div class="mb-3 text-xs text-[var(--text-muted)]">
    <.link
      navigate={~p"/"}
      class="text-[var(--accent)] hover:underline"
    >
      Home
    </.link>

    <span class="mx-1">»</span>

    <span class="text-[var(--text)]">
      Calendar
    </span>
  </div>

  <%!-- Calendar panel --%>
  <section class="border border-[var(--border)] bg-[var(--surface)]">
    <%!-- Header --%>
    <div class="old-panel-header px-3 py-2">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
            Release calendar
          </h1>

          <p class="mt-0.5 text-xs text-[var(--text-muted)]">
            Anime episodes airing this week.
          </p>
        </div>

        <span class="text-xs font-semibold text-[var(--text)]">
          {Calendar.strftime(@week_start, "%d %B")} – {Calendar.strftime(@week_end, "%d %B %Y")}
        </span>
      </div>
    </div>

    <%!-- Week controls --%>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-2">
      <div class="flex items-center gap-1">
        <button
          type="button"
          phx-click="previous_week"
          class="border border-[var(--border)] bg-[var(--surface)] px-3 py-1.5 text-sm font-semibold text-[var(--text)] hover:bg-[var(--surface-strong)]"
        >
          « Previous
        </button>

        <button
          type="button"
          phx-click="this_week"
          class="old-button px-3 py-1.5"
        >
          This week
        </button>

        <button
          type="button"
          phx-click="next_week"
          class="border border-[var(--border)] bg-[var(--surface)] px-3 py-1.5 text-sm font-semibold text-[var(--text)] hover:bg-[var(--surface-strong)]"
        >
          Next »
        </button>
      </div>

      <%!-- Client-side filters --%>
      <div class="flex items-center gap-1">
        <span class="mr-1 text-xs font-bold uppercase text-[var(--text-muted)]">
          Show:
        </span>

        <button
          type="button"
          data-calendar-filter="all"
          class="calendar-filter border border-[var(--button-border)] bg-[var(--accent)] px-3 py-1 text-xs font-semibold text-white"
        >
          All
        </button>

        <button
          type="button"
          data-calendar-filter="watching"
          class="calendar-filter border border-[var(--border)] bg-[var(--surface)] px-3 py-1 text-xs font-semibold text-[var(--text)] hover:bg-[var(--surface-hover)]"
        >
          Watching only
        </button>
      </div>
    </div>

    <%!-- Days --%>
    <div class="divide-y divide-[var(--border)]">
      <%= for day <- @days do %>
        <section
          data-calendar-day={Date.to_iso8601(day)}
          class="calendar-day"
        >
          <%!-- Day header --%>
          <div class="flex items-center justify-between gap-4 border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-1.5">
            <div class="flex min-w-0 items-center gap-2">
              <h2 class="text-sm font-bold text-[var(--text)]">
                {day_name(day)}
              </h2>

              <span class="text-xs text-[var(--text-muted)]">
                {Calendar.strftime(day, "%d %B")}
              </span>

              <span
                data-today-badge
                class="hidden border border-[var(--button-border)] bg-[var(--accent)] px-1.5 py-0.5 text-[10px] font-bold uppercase text-white"
              >
                Today
              </span>
            </div>

            <span
              data-release-count
              class="shrink-0 text-xs text-[var(--text-muted)]"
            >
              0 releases
            </span>
          </div>

          <%!-- Filled by LocalCalendar --%>
          <div
            data-day-results
            class="divide-y divide-[var(--border)]"
          >
          </div>

          <%!-- Empty day --%>
          <div
            data-day-empty
            class="px-3 py-4 text-sm italic text-[var(--text-muted)]"
          >
            Nothing airing.
          </div>
        </section>
      <% end %>
    </div>
  </section>

  <%!-- Raw airing data used by LocalCalendar hook --%>
  <div class="hidden">
    <%= for schedule <- @schedules do %>
      <div
        data-airing
        data-airing-at={schedule["airingAt"]}
        data-media-id={schedule["media"]["id"]}
        data-title={
          schedule["media"]["title"]["english"] ||
            schedule["media"]["title"]["romaji"]
        }
        data-cover={schedule["media"]["coverImage"]["large"]}
        data-episode={schedule["episode"]}
        data-library-status={library_status(@watching_ids, schedule["media"]["id"])}
      >
      </div>
    <% end %>
  </div>
</div>
