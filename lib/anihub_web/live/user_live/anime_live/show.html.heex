<div class="mx-auto max-w-6xl px-3 py-5 sm:px-4">
  <.app_nav current={:home} current_scope={@current_scope} />

  <%!-- Search --%>
  <div class="relative z-50 mb-5 border border-[var(--border)] bg-[var(--surface)] p-2">
    <.live_component module={AnihubWeb.SearchComponent} id="anime-search" />
  </div>

  <%!-- Breadcrumb --%>
  <div class="mb-3 text-xs text-[var(--text-muted)]">
    <.link navigate={~p"/"} class="text-[var(--accent)] hover:underline">
      Home
    </.link>

    <span class="mx-1">»</span>

    <span>Anime</span>

    <span class="mx-1">»</span>

    <span class="text-[var(--text)]">
      {@anime["title"]["english"] || @anime["title"]["romaji"]}
    </span>
  </div>

  <%!-- Main information panel --%>
  <section class="border border-[var(--border)] bg-[var(--surface)]">
    <div class="old-panel-header px-3 py-2">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
          Anime information
        </h2>

        <span
          :if={@anime["status"]}
          class="text-xs text-[var(--text-muted)]"
        >
          {anime_status_label(@anime["status"])}
        </span>
      </div>
    </div>

    <div class="grid md:grid-cols-[210px_minmax(0,1fr)]">
      <%!-- Left column --%>
      <aside class="border-b border-[var(--border)] p-3 md:border-b-0 md:border-r">
        <img
          src={@anime["coverImage"]["extraLarge"]}
          alt={@anime["title"]["english"] || @anime["title"]["romaji"]}
          class="mx-auto aspect-[2/3] w-full max-w-[190px] border border-[var(--border)] object-cover"
        />

        <%!-- Basic info --%>
        <div class="mt-3 border border-[var(--border)] text-xs">
          <div class="old-panel-header px-2 py-1 font-bold uppercase">
            Information
          </div>

          <dl class="divide-y divide-[var(--border)]">
            <div :if={@anime["format"]} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Type</dt>
              <dd>{format_label(@anime["format"])}</dd>
            </div>

            <div :if={@anime["episodes"]} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Episodes</dt>
              <dd>{@anime["episodes"]}</dd>
            </div>

            <div :if={@anime["duration"]} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Duration</dt>
              <dd>{@anime["duration"]} min</dd>
            </div>

            <div :if={@anime["season"] && @anime["seasonYear"]} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Season</dt>
              <dd>{season_label(@anime["season"])} {@anime["seasonYear"]}</dd>
            </div>

            <div :if={@anime["source"]} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Source</dt>
              <dd>{source_label(@anime["source"])}</dd>
            </div>

            <div :if={main_studio(@anime["studios"])} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Studio</dt>
              <dd>{main_studio(@anime["studios"])}</dd>
            </div>

            <div :if={@anime["countryOfOrigin"]} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Country</dt>
              <dd>{country_label(@anime["countryOfOrigin"])}</dd>
            </div>

            <div :if={anime_date(@anime["startDate"])} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Started</dt>
              <dd>{anime_date(@anime["startDate"])}</dd>
            </div>

            <div :if={anime_date(@anime["endDate"])} class="grid grid-cols-[72px_1fr] gap-2 px-2 py-1.5">
              <dt class="font-semibold text-[var(--text-muted)]">Ended</dt>
              <dd>{anime_date(@anime["endDate"])}</dd>
            </div>
          </dl>
        </div>

        <%!-- Genres --%>
        <div
          :if={@anime["genres"] && @anime["genres"] != []}
          class="mt-3 border border-[var(--border)]"
        >
          <div class="old-panel-header px-2 py-1 text-xs font-bold uppercase">
            Genres
          </div>

          <div class="p-2 text-xs leading-6">
            <%= for {genre, index} <- Enum.with_index(@anime["genres"]) do %>
              <span class="text-[var(--accent)]">
                {genre}
              </span>

              <%= if index < length(@anime["genres"]) - 1 do %>
                <span class="text-[var(--text-muted)]">, </span>
              <% end %>
            <% end %>
          </div>
        </div>
      </aside>

      <%!-- Right column --%>
      <div class="min-w-0 p-4">
        <header>
          <h1 class="text-2xl font-bold leading-tight text-[var(--accent)] sm:text-3xl">
            {@anime["title"]["english"] || @anime["title"]["romaji"]}
          </h1>

          <p
            :if={
              @anime["title"]["english"] &&
                @anime["title"]["romaji"] &&
                @anime["title"]["english"] != @anime["title"]["romaji"]
            }
            class="mt-1 text-sm text-[var(--text-muted)]"
          >
            {@anime["title"]["romaji"]}
          </p>

          <%!-- Main statistics --%>
          <div class="mt-3 border-y border-[var(--border)] py-2">
            <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
              <span :if={@anime["averageScore"]}>
                <span class="text-[var(--text-muted)]">Score:</span>
                <strong>{@anime["averageScore"]}%</strong>
              </span>

              <span :if={@anime["episodes"]}>
                <span class="text-[var(--text-muted)]">Episodes:</span>
                <strong>{@anime["episodes"]}</strong>
              </span>

              <span :if={@anime["seasonYear"]}>
                <span class="text-[var(--text-muted)]">Year:</span>
                <strong>{@anime["seasonYear"]}</strong>
              </span>

              <span :if={main_studio(@anime["studios"])}>
                <span class="text-[var(--text-muted)]">Studio:</span>
                <strong>{main_studio(@anime["studios"])}</strong>
              </span>
            </div>
          </div>
        </header>

        <%!-- Library panel --%>
        <section class="mt-4 border border-[var(--border)]">
          <div class="old-panel-header flex items-center justify-between gap-3 px-3 py-2">
            <h2 class="text-sm font-bold uppercase tracking-wide">
              Your library
            </h2>

            <button
              :if={@library_entry}
              type="button"
              phx-click="remove_from_library"
              class="text-xs font-medium text-rose-500 hover:underline"
            >
              Remove
            </button>
          </div>

          <%= if @library_entry do %>
            <div class="p-3">
              <div class="text-sm">
                <span class="text-[var(--text-muted)]">
                  Current status:
                </span>

                <strong class="ml-1 capitalize">
                  {@library_entry.status}
                </strong>
              </div>

              <%!-- Status --%>
              <div class="mt-4">
                <div class="mb-1 text-xs font-bold uppercase text-[var(--text-muted)]">
                  Status
                </div>

                <div class="flex flex-wrap gap-1">
                  <%= for status <- [:watching, :planning, :completed, :dropped] do %>
                    <button
                      type="button"
                      phx-click="set_status"
                      phx-value-status={status}
                      class={status_button_class(status, @library_entry.status)}
                    >
                      {status
                      |> Atom.to_string()
                      |> String.capitalize()}
                    </button>
                  <% end %>
                </div>
              </div>

              <%!-- Progress --%>
              <div class="mt-4 border-t border-[var(--border)] pt-3">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <span class="text-xs font-bold uppercase text-[var(--text-muted)]">
                      Progress
                    </span>

                    <span class="ml-2 text-sm font-semibold">
                      {@library_entry.progress || 0}/{@anime["episodes"] || "?"}
                    </span>
                  </div>

                  <div class="flex gap-1">
                    <button
                      type="button"
                      phx-click="decrement_progress"
                      disabled={(@library_entry.progress || 0) <= 0}
                      class="border border-[var(--border)] bg-[var(--surface-hover)] px-3 py-1 text-sm font-bold hover:bg-[var(--surface-strong)] disabled:cursor-not-allowed disabled:opacity-30"
                    >
                      −
                    </button>

                    <button
                      type="button"
                      phx-click="increment_progress"
                      disabled={
                        @anime["episodes"] != nil &&
                          (@library_entry.progress || 0) >= @anime["episodes"]
                      }
                      class="old-button px-3 py-1"
                    >
                      +
                    </button>
                  </div>
                </div>

                <progress
                  :if={is_integer(@anime["episodes"]) && @anime["episodes"] > 0}
                  value={@library_entry.progress || 0}
                  max={@anime["episodes"]}
                  class="mt-2 w-full"
                >
                  {@library_entry.progress || 0}
                </progress>
              </div>
            </div>
          <% else %>
            <div class="p-3">
              <p class="text-sm text-[var(--text-muted)]">
                This anime is not currently in your library.
              </p>

              <div class="mt-3 flex flex-wrap gap-1">
                <button
                  type="button"
                  phx-click="add_to_library"
                  phx-value-status="watching"
                  class="border border-blue-700 bg-blue-700 px-3 py-1.5 text-sm font-semibold text-white"
                >
                  Watching
                </button>

                <button
                  type="button"
                  phx-click="add_to_library"
                  phx-value-status="planning"
                  class="border border-violet-700 bg-violet-700 px-3 py-1.5 text-sm font-semibold text-white"
                >
                  Planning
                </button>

                <button
                  type="button"
                  phx-click="add_to_library"
                  phx-value-status="completed"
                  class="border border-emerald-700 bg-emerald-700 px-3 py-1.5 text-sm font-semibold text-white"
                >
                  Completed
                </button>

                <button
                  type="button"
                  phx-click="add_to_library"
                  phx-value-status="dropped"
                  class="border border-rose-700 bg-rose-700 px-3 py-1.5 text-sm font-semibold text-white"
                >
                  Dropped
                </button>
              </div>
            </div>
          <% end %>
        </section>

        <%!-- Synopsis --%>
        <section
          :if={@anime["description"]}
          class="mt-4 border border-[var(--border)]"
        >
          <div class="old-panel-header px-3 py-2">
            <h2 class="text-sm font-bold uppercase tracking-wide">
              Synopsis
            </h2>
          </div>

          <div class="p-3 text-sm leading-6 text-[var(--text-muted)]">
            {Phoenix.HTML.raw(@anime["description"])}
          </div>
        </section>

        <%!-- Native title --%>
        <section
          :if={@anime["title"]["native"]}
          class="mt-4 border border-[var(--border)]"
        >
          <div class="old-panel-header px-3 py-2">
            <h2 class="text-sm font-bold uppercase tracking-wide">
              Alternative titles
            </h2>
          </div>

          <div class="grid grid-cols-[110px_1fr] gap-3 p-3 text-sm">
            <span class="font-semibold text-[var(--text-muted)]">
              Native
            </span>

            <span>
              {@anime["title"]["native"]}
            </span>
          </div>
        </section>
      </div>
    </div>
  </section>

  <%!-- Related anime --%>
  <section
    :if={related_anime(@anime) != []}
    class="mt-6 border border-[var(--border)] bg-[var(--surface)]"
  >
    <div class="old-panel-header px-3 py-2">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-bold uppercase tracking-wide">
          Related anime
        </h2>

        <span class="text-xs text-[var(--text-muted)]">
          Sequels, prequels and related titles
        </span>
      </div>
    </div>

    <div class="divide-y divide-[var(--border)]">
      <.link
        :for={relation <- related_anime(@anime)}
        navigate={~p"/anime/#{relation["node"]["id"]}"}
        class="group grid grid-cols-[48px_minmax(0,1fr)] gap-3 px-3 py-2 hover:bg-[var(--surface-hover)] sm:grid-cols-[48px_minmax(0,1fr)_90px_80px]"
      >
        <img
          src={relation["node"]["coverImage"]["large"]}
          alt={
            relation["node"]["title"]["english"] ||
              relation["node"]["title"]["romaji"]
          }
          class="h-16 w-11 border border-[var(--border)] object-cover"
        />

        <div class="min-w-0 self-center">
          <div class="truncate text-sm font-semibold text-[var(--accent)] group-hover:underline">
            {relation["node"]["title"]["english"] ||
              relation["node"]["title"]["romaji"]}
          </div>

          <div class="mt-0.5 text-xs text-[var(--text-muted)] sm:hidden">
            {relation_label(relation["relationType"])}
          </div>
        </div>

        <div class="hidden self-center text-xs sm:block">
          <div class="text-[var(--text-muted)]">
            Relation
          </div>

          <div class="font-semibold">
            {relation_label(relation["relationType"])}
          </div>
        </div>

        <div class="hidden self-center text-right text-xs sm:block">
          <div class="text-[var(--text-muted)]">
            Year
          </div>

          <div class="font-semibold">
            {relation["node"]["seasonYear"] || "—"}
          </div>
        </div>
      </.link>
    </div>
  </section>
</div>
