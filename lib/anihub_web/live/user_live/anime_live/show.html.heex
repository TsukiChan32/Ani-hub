<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <.app_nav current={:home} current_scope={@current_scope} />

  <%!-- Search --%>
    <div class="relative z-50 mb-10">
      <.live_component module={AnihubWeb.SearchComponent} id="anime-search" />
    </div>

    <%!-- Main anime section --%>
      <section
        class="grid items-start gap-8 md:grid-cols-[240px_minmax(0,1fr)] lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-12">
        <%!-- Cover --%>
          <div class="mx-auto w-full max-w-[280px] md:mx-0">
            <div class="overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--surface)]">
              <img src={@anime["coverImage"]["extraLarge"]} alt={ @anime["title"]["english"] ||
                @anime["title"]["romaji"] } class="aspect-[2/3] w-full object-cover" />
            </div>
          </div>

          <%!-- Information --%>
            <div class="min-w-0">
              <header>
                <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
                  Anime
                </p>

                <h1 class="mt-2 text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">
                  {@anime["title"]["english"] || @anime["title"]["romaji"]}
                </h1>

                <%!-- Romaji title --%>
                  <p :if={ @anime["title"]["english"] && @anime["title"]["romaji"] && @anime["title"]["english"]
                    !=@anime["title"]["romaji"] } class="mt-2 text-base text-[var(--text-muted)]">
                    {@anime["title"]["romaji"]}
                  </p>

                  <%!-- Main metadata --%>
                    <div class="mt-5 flex flex-wrap gap-2">
                      <span :if={@anime["averageScore"]}
                        class="rounded-xl bg-[var(--surface)] px-3 py-2 text-sm text-[var(--text-muted)]">
                        Score
                        <strong class="ml-1 font-semibold text-[var(--text)]">
                          {@anime["averageScore"]}%
                        </strong>
                      </span>

                      <span :if={@anime["episodes"]}
                        class="rounded-xl bg-[var(--surface)] px-3 py-2 text-sm text-[var(--text-muted)]">
                        <strong class="font-semibold text-[var(--text)]">
                          {@anime["episodes"]}
                        </strong>
                        episodes
                      </span>

                      <span :if={@anime["seasonYear"]}
                        class="rounded-xl bg-[var(--surface)] px-3 py-2 text-sm font-medium text-[var(--text)]">
                        {@anime["seasonYear"]}
                      </span>
                    </div>

                    <%!-- Airing / production metadata --%>
                      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-[var(--text-muted)]">
                        <span :if={@anime["status"]} class="flex items-center gap-2">
                          <span class={airing_status_dot_class(@anime["status"])}></span>

                          <span>
                            {anime_status_label(@anime["status"])}
                          </span>
                        </span>

                        <span :if={@anime["season"] && @anime["seasonYear"]} class="contents">
                          <span class="text-[var(--border)]">
                            •
                          </span>

                          <span>
                            {season_label(@anime["season"])} {@anime["seasonYear"]}
                          </span>
                        </span>

                        <span :if={@anime["format"]} class="contents">
                          <span class="text-[var(--border)]">
                            •
                          </span>

                          <span>
                            {format_label(@anime["format"])}
                          </span>
                        </span>

                        <span :if={@anime["duration"]} class="contents">
                          <span class="text-[var(--border)]">
                            •
                          </span>

                          <span>
                            {@anime["duration"]} min
                          </span>
                        </span>

                        <span :if={main_studio(@anime["studios"])} class="contents">
                          <span class="text-[var(--border)]">
                            •
                          </span>

                          <span>
                            {main_studio(@anime["studios"])}
                          </span>
                        </span>
                      </div>
              </header>

              <%!-- Library --%>
                <%= if @library_entry do %>
                  <section class="mt-7 rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--accent)]">
                          Your Library
                        </p>

                        <p class="mt-2 text-lg font-bold capitalize text-[var(--text)]">
                          {@library_entry.status}
                        </p>
                      </div>

                      <button phx-click="remove_from_library"
                        class="rounded-xl px-3 py-2 text-sm font-medium text-rose-500/80 transition-colors hover:bg-rose-500/10 hover:text-rose-500">
                        Remove
                      </button>
                    </div>

                    <%!-- Status --%>
                      <div class="mt-6">
                        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                          Status
                        </p>

                        <div class="flex flex-wrap gap-2">
                          <%= for status <- [:watching, :planning, :completed, :dropped] do %>
                            <button phx-click="set_status" phx-value-status={status} class={ status_button_class(
                              status, @library_entry.status ) }>
                              {status
                              |> Atom.to_string()
                              |> String.capitalize()}
                            </button>
                            <% end %>
                        </div>
                      </div>

                      <%!-- Progress --%>
                        <div class="mt-6">
                          <div class="flex items-end justify-between gap-4">
                            <div>
                              <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                                Progress
                              </p>

                              <p class="mt-1 text-lg font-bold text-[var(--text)]">
                                {@library_entry.progress || 0}

                                <span class="font-normal text-[var(--text-muted)]">
                                  / {@anime["episodes"] || "?"}
                                </span>
                              </p>
                            </div>

                            <div class="flex gap-2">
                              <button phx-click="decrement_progress" disabled={(@library_entry.progress || 0) <=0}
                                class="flex size-10 items-center justify-center rounded-xl bg-[var(--surface-hover)] text-lg font-semibold text-[var(--text)] transition-colors hover:bg-[var(--surface-strong)] disabled:cursor-not-allowed disabled:opacity-30"
                                aria-label="Decrease progress">
                                −
                              </button>

                              <button phx-click="increment_progress" disabled={ @anime["episodes"] !=nil &&
                                (@library_entry.progress || 0)>= @anime["episodes"]
                                }
                                class="flex size-10 items-center justify-center rounded-xl bg-[var(--accent)] text-lg
                                font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]
                                disabled:cursor-not-allowed disabled:opacity-30"
                                aria-label="Increase progress"
                                >
                                +
                              </button>
                            </div>
                          </div>

                          <progress :if={is_integer(@anime["episodes"]) && @anime["episodes"]> 0}
                            value={@library_entry.progress || 0}
                            max={@anime["episodes"]}
                            class="mt-4 h-2 w-full overflow-hidden rounded-full"
                            >
                            {@library_entry.progress || 0}
                          </progress>
                        </div>
                  </section>
                  <% else %>
                    <%!-- Add to library --%>
                      <section class="mt-7 rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6">
                        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--accent)]">
                          Your Library
                        </p>

                        <h2 class="mt-1 text-lg font-bold text-[var(--text)]">
                          Start tracking
                        </h2>

                        <p class="mt-2 text-sm text-[var(--text-muted)]">
                          Choose a status to add this anime to your library.
                        </p>

                        <div class="mt-5 flex flex-wrap gap-2">
                          <button phx-click="add_to_library" phx-value-status="watching"
                            class="rounded-xl bg-blue-500/15 px-4 py-2 text-sm font-semibold text-blue-500 transition-colors hover:bg-blue-500/25">
                            Watching
                          </button>

                          <button phx-click="add_to_library" phx-value-status="planning"
                            class="rounded-xl bg-violet-500/15 px-4 py-2 text-sm font-semibold text-violet-500 transition-colors hover:bg-violet-500/25">
                            Planning
                          </button>

                          <button phx-click="add_to_library" phx-value-status="completed"
                            class="rounded-xl bg-emerald-500/15 px-4 py-2 text-sm font-semibold text-emerald-500 transition-colors hover:bg-emerald-500/25">
                            Completed
                          </button>

                          <button phx-click="add_to_library" phx-value-status="dropped"
                            class="rounded-xl bg-rose-500/15 px-4 py-2 text-sm font-semibold text-rose-500 transition-colors hover:bg-rose-500/25">
                            Dropped
                          </button>
                        </div>
                      </section>
                      <% end %>

                        <%!-- Genres --%>
                          <div :if={@anime["genres"] && @anime["genres"] !=[]} class="mt-7 flex flex-wrap gap-2">
                            <span :for={genre <- @anime["genres"]}
                              class="rounded-full bg-[var(--accent-soft)] px-3 py-1.5 text-xs font-medium text-[var(--accent)]">
                              {genre}
                            </span>
                          </div>
            </div>
      </section>

      <%!-- Synopsis --%>
        <section :if={@anime["description"]}
          class="mt-10 border-t border-[var(--border)] pt-8 md:ml-[288px] lg:ml-[328px]">
          <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
            About
          </p>

          <h2 class="mt-1 text-2xl font-bold tracking-tight text-[var(--text)]">
            Synopsis
          </h2>

          <div class="mt-4 max-w-3xl text-base leading-8 text-[var(--text-muted)]">
            {Phoenix.HTML.raw(@anime["description"])}
          </div>
        </section>

        <%!-- Details --%>
          <section class="mt-10 border-t border-[var(--border)] pt-8 md:ml-[288px] lg:ml-[328px]">
            <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
              Information
            </p>

            <h2 class="mt-1 text-2xl font-bold tracking-tight text-[var(--text)]">
              Details
            </h2>

            <div class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
              <div :if={@anime["title"]["native"]}>
                <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  Native title
                </p>

                <p class="mt-1 font-medium text-[var(--text)]">
                  {@anime["title"]["native"]}
                </p>
              </div>

              <div :if={@anime["source"]}>
                <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  Source
                </p>

                <p class="mt-1 font-medium text-[var(--text)]">
                  {source_label(@anime["source"])}
                </p>
              </div>

              <div :if={@anime["countryOfOrigin"]}>
                <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  Country
                </p>

                <p class="mt-1 font-medium text-[var(--text)]">
                  {country_label(@anime["countryOfOrigin"])}
                </p>
              </div>

              <div :if={anime_date(@anime["startDate"])}>
                <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  Start date
                </p>

                <p class="mt-1 font-medium text-[var(--text)]">
                  {anime_date(@anime["startDate"])}
                </p>
              </div>

              <div :if={anime_date(@anime["endDate"])}>
                <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  End date
                </p>

                <p class="mt-1 font-medium text-[var(--text)]">
                  {anime_date(@anime["endDate"])}
                </p>
              </div>

              <div :if={main_studio(@anime["studios"])}>
                <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  Studio
                </p>

                <p class="mt-1 font-medium text-[var(--text)]">
                  {main_studio(@anime["studios"])}
                </p>
              </div>
            </div>
          </section>
          <%!-- Related anime --%>
            <section :if={related_anime(@anime) !=[]} class="mt-12 border-t border-[var(--border)] pt-8">
              <div>
                <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
                  Related
                </p>

                <h2 class="mt-1 text-2xl font-bold tracking-tight text-[var(--text)]">
                  Related anime
                </h2>

                <p class="mt-2 text-sm text-[var(--text-muted)]">
                  Sequels, prequels and other related titles.
                </p>
              </div>

              <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
                <.link :for={relation <- related_anime(@anime)} navigate={~p"/anime/#{relation["node"]["id"]}"}
                  class="group block min-w-0">
                  <%!-- Cover --%>
                    <div class="overflow-hidden rounded-2xl bg-[var(--surface)]">
                      <img src={relation["node"]["coverImage"]["large"]} alt={ relation["node"]["title"]["english"] ||
                        relation["node"]["title"]["romaji"] }
                        class="aspect-[2/3] w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]" />
                    </div>

                    <%!-- Relation info --%>
                      <div class="mt-3">
                        <p class="text-xs font-semibold uppercase tracking-wide text-[var(--accent)]">
                          {relation_label(relation["relationType"])}
                        </p>

                        <h3
                          class="mt-1 truncate font-semibold text-[var(--text)] transition-colors group-hover:text-[var(--accent)]">
                          {relation["node"]["title"]["english"] ||
                          relation["node"]["title"]["romaji"]}
                        </h3>

                        <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-[var(--text-muted)]">
                          <span :if={relation["node"]["format"]}>
                            {format_label(relation["node"]["format"])}
                          </span>

                          <span :if={relation["node"]["format"] && relation["node"]["seasonYear"]}
                            class="text-[var(--border)]">
                            •
                          </span>

                          <span :if={relation["node"]["seasonYear"]}>
                            {relation["node"]["seasonYear"]}
                          </span>
                        </div>
                      </div>
                </.link>
              </div>
            </section>
</div>