<div class="mx-auto max-w-6xl px-3 py-5 sm:px-4">
  <.app_nav current={:search} current_scope={assigns[:current_scope]} />

  <%!-- Search --%>
  <div class="relative z-50 mb-5 border border-[var(--border)] bg-[var(--surface)] p-2">
    <.live_component
      module={AnihubWeb.SearchComponent}
      id="search-page-search"
    />
  </div>

  <%!-- Breadcrumb --%>
  <div class="mb-3 text-xs text-[var(--text-muted)]">
    <.link navigate={~p"/"} class="text-[var(--accent)] hover:underline">
      Home
    </.link>

    <span class="mx-1">»</span>

    <span class="text-[var(--text)]">
      Search
    </span>
  </div>

  <section class="border border-[var(--border)] bg-[var(--surface)]">
    <%!-- Header --%>
    <div class="old-panel-header px-3 py-2">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
            Search anime
          </h1>

          <p class="mt-0.5 text-xs text-[var(--text-muted)]">
            Search the AniList database.
          </p>
        </div>

        <%= if @query != "" and String.length(@query) >= 2 do %>
          <span class="text-xs text-[var(--text-muted)]">
            {length(@results)} results
          </span>
        <% end %>
      </div>
    </div>

    <%= cond do %>
      <% @query == "" -> %>
        <div class="px-3 py-8 text-center">
          <p class="text-sm font-semibold text-[var(--text)]">
            Search for an anime
          </p>

          <p class="mt-1 text-sm text-[var(--text-muted)]">
            Enter a title in the search box above.
          </p>
        </div>
      <% String.length(@query) < 2 -> %>
        <div class="px-3 py-8 text-center">
          <p class="text-sm font-semibold text-[var(--text)]">
            Keep typing
          </p>

          <p class="mt-1 text-sm text-[var(--text-muted)]">
            Enter at least two characters.
          </p>
        </div>
      <% @results == [] -> %>
        <div class="px-3 py-8 text-center">
          <p class="text-sm font-semibold text-[var(--text)]">
            No results found
          </p>

          <p class="mt-1 text-sm text-[var(--text-muted)]">
            Nothing matched “{@query}”.
          </p>
        </div>
      <% true -> %>
        <%!-- Query summary --%>
        <div class="border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-2 text-sm">
          Results for
          <strong class="text-[var(--text)]">
            “{@query}”
          </strong>
        </div>

        <%!-- Desktop header --%>
        <div class="hidden grid-cols-[58px_minmax(0,1fr)_90px_90px_100px] border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-1.5 text-xs font-bold uppercase text-[var(--text-muted)] sm:grid">
          <div>Cover</div>
          <div>Title</div>
          <div class="text-right">Score</div>
          <div class="text-right">Episodes</div>
          <div class="text-right">Year</div>
        </div>

        <div class="divide-y divide-[var(--border)]">
          <%= for anime <- @results do %>
            <.link
              navigate={~p"/anime/#{anime["id"]}"}
              class="group grid grid-cols-[58px_minmax(0,1fr)] gap-3 px-3 py-2 hover:bg-[var(--surface-hover)] sm:grid-cols-[58px_minmax(0,1fr)_90px_90px_100px]"
            >
              <img
                src={anime["coverImage"]["large"]}
                alt={
                  anime["title"]["english"] ||
                    anime["title"]["romaji"]
                }
                class="h-20 w-14 border border-[var(--border)] object-cover"
              />

              <div class="min-w-0 self-center">
                <h2 class="truncate text-sm font-bold text-[var(--accent)] group-hover:underline">
                  {anime["title"]["english"] || anime["title"]["romaji"]}
                </h2>

                <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-[var(--text-muted)] sm:hidden">
                  <%= if anime["averageScore"] do %>
                    <span>
                      Score:
                      <strong class="text-[var(--text)]">
                        {anime["averageScore"]}%
                      </strong>
                    </span>
                  <% end %>

                  <%= if anime["episodes"] do %>
                    <span>
                      {anime["episodes"]} eps
                    </span>
                  <% end %>

                  <%= if anime["seasonYear"] do %>
                    <span>
                      {anime["seasonYear"]}
                    </span>
                  <% end %>
                </div>
              </div>

              <div class="hidden self-center text-right text-xs sm:block">
                <%= if anime["averageScore"] do %>
                  <strong class="text-[var(--text)]">
                    {anime["averageScore"]}%
                  </strong>
                <% else %>
                  <span class="text-[var(--text-muted)]">—</span>
                <% end %>
              </div>

              <div class="hidden self-center text-right text-xs sm:block">
                <%= if anime["episodes"] do %>
                  <strong class="text-[var(--text)]">
                    {anime["episodes"]}
                  </strong>
                <% else %>
                  <span class="text-[var(--text-muted)]">?</span>
                <% end %>
              </div>

              <div class="hidden self-center text-right text-xs sm:block">
                <%= if anime["seasonYear"] do %>
                  <strong class="text-[var(--text)]">
                    {anime["seasonYear"]}
                  </strong>
                <% else %>
                  <span class="text-[var(--text-muted)]">—</span>
                <% end %>
              </div>
            </.link>
          <% end %>
        </div>
    <% end %>
  </section>
</div>
