<div class="mx-auto max-w-3xl px-6 py-12">
  <h1 class="mb-6 text-3xl font-bold">
    Search anime
  </h1>

  <form phx-change="search">
    <input
      type="search"
      name="q"
      value={@query}
      placeholder="Search anime..."
      phx-debounce="300"
      autocomplete="off"
      class="w-full rounded-xl bg-zinc-900 px-4 py-3 ring-1 ring-zinc-700 outline-none focus:ring-zinc-500"
    />
  </form>

  <div class="mt-8 space-y-4">
    <%= for anime <- @results do %>
      <.link
        navigate={~p"/anime/#{anime["id"]}"}
        class="flex gap-4 rounded-xl bg-zinc-900 p-4 hover:bg-zinc-800"
      >
        <img
          src={anime["coverImage"]["large"]}
          alt={anime["title"]["english"] || anime["title"]["romaji"]}
          class="h-24 w-16 rounded-lg object-cover"
        />

        <div>
          <h2 class="font-semibold">
            {anime["title"]["english"] || anime["title"]["romaji"]}
          </h2>

          <%= if anime["averageScore"] do %>
            <p class="mt-1 text-sm text-zinc-400">
              Score: {anime["averageScore"]}%
            </p>
          <% end %>
        </div>
      </.link>
    <% end %>
  </div>
</div>
