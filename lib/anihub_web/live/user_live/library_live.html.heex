<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <%!-- Navigation --%>
  <.app_nav current={:library} />

  <%!-- Search --%>
  <div class="relative z-50 mb-12">
    <.live_component module={AnihubWeb.SearchComponent} id="library-search" />
  </div>

  <%!-- Header --%>
  <section class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">
      Collection
    </p>

    <div class="mt-1 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-[var(--text)]">
          Your Library
        </h1>

        <p class="mt-2 text-sm text-[var(--text-muted)]">
          Keep track of what you're watching.
        </p>
      </div>

      <p class="text-sm text-[var(--text-muted)]">
        {length(@library)} anime
      </p>
    </div>
  </section>

  <%!-- Filters --%>
  <div class="mb-8 flex flex-wrap gap-2">
    <%= for {filter, label} <- [ {"all", "All" }, {"watching", "Watching" }, {"planning", "Planning"
                            }, {"completed", "Completed" }, {"dropped", "Dropped" } ] do %>
      <button phx-click="filter" phx-value-status={filter} class={filter_class(filter, @filter)}>
        {label}
      </button>
    <% end %>
  </div>

  <% filtered = filtered_library(@library, @filter) %>

  <%= if filtered==[] do %>
    <div class="
      rounded-2xl
      border border-[var(--border)]
      bg-[var(--surface)]
      px-6 py-14
      text-center
    ">
      <p class="font-medium text-[var(--text)]">
        Nothing here yet
      </p>

      <%= if @filter !="all" do %>
        <p class="mt-2 text-sm text-[var(--text-muted)]">
          You don't have any {@filter} anime.
        </p>
      <% else %>
        <p class="mt-2 text-sm text-[var(--text-muted)]">
          Add something from the anime page and it will show up here.
        </p>
      <% end %>
    </div>
  <% else %>
    <div class="
      grid grid-cols-2
      gap-x-4 gap-y-8
      sm:grid-cols-3
      md:grid-cols-4
      lg:grid-cols-5
    ">
      <%= for item <- filtered do %>
        <.link navigate={~p"/anime/#{item.anime["id"]}"} class="group block min-w-0">
          <div class="
            relative
            overflow-hidden
            rounded-2xl
            bg-[var(--surface)]
          ">
            <img
              src={item.anime["coverImage"]["large"]}
              alt={
                item.anime["title"]["english"] ||
                  item.anime["title"]["romaji"]
              }
              class="
                aspect-[2/3]
                w-full
                object-cover
                transition-transform
                duration-200
                group-hover:scale-[1.02]
              "
            />

            <div class="absolute bottom-2 left-2">
              <span class={status_badge_class(item.entry.status)}>
                {item.entry.status}
              </span>
            </div>
          </div>

          <div class="mt-3">
            <h2 class="
              truncate
              font-semibold
              text-[var(--text)]
              transition-colors
              group-hover:text-[var(--accent)]
            ">
              {item.anime["title"]["english"] || item.anime["title"]["romaji"]}
            </h2>

            <div class="
              mt-1
              flex items-center gap-2
              text-sm
              text-[var(--text-muted)]
            ">
              <span>
                {item.entry.progress}/{item.anime["episodes"] || "?"}
              </span>

              <%= if item.anime["averageScore"] do %>
                <span class="text-[var(--border)]">
                  •
                </span>

                <span>
                  {item.anime["averageScore"]}%
                </span>
              <% end %>
            </div>
          </div>
        </.link>
      <% end %>
    </div>
  <% end %>
</div>
