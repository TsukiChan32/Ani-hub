<div class="mx-auto max-w-6xl px-3 py-5 sm:px-4">
  <.app_nav current={:library} current_scope={@current_scope} />

  <%!-- Search --%>
  <div class="relative z-50 mb-5 border border-[var(--border)] bg-[var(--surface)] p-2">
    <.live_component module={AnihubWeb.SearchComponent} id="library-search" />
  </div>

  <%!-- Breadcrumb --%>
  <div class="mb-3 text-xs text-[var(--text-muted)]">
    <.link navigate={~p"/"} class="text-[var(--accent)] hover:underline">
      Home
    </.link>

    <span class="mx-1">»</span>

    <span class="text-[var(--text)]">
      Library
    </span>
  </div>

  <%!-- Main library panel --%>
  <section class="border border-[var(--border)] bg-[var(--surface)]">
    <%!-- Header --%>
    <div class="old-panel-header px-3 py-2">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-sm font-bold uppercase tracking-wide text-[var(--text)]">
            Your library
          </h1>

          <p class="mt-0.5 text-xs text-[var(--text-muted)]">
            Track progress, status and your own scores.
          </p>
        </div>

        <span class="text-xs text-[var(--text-muted)]">
          {length(@library)} anime
        </span>
      </div>
    </div>

    <%!-- AniList error --%>
    <%= if @anime_load_error do %>
      <div class="border-b border-amber-700 bg-amber-100 px-3 py-2 text-sm text-amber-950 dark:bg-amber-950 dark:text-amber-100">
        <strong>AniList is temporarily unavailable.</strong>
        Your library data is safe, but anime metadata could not be loaded.
      </div>
    <% end %>

    <%!-- Filters --%>
    <div class="border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-2">
      <div class="flex flex-wrap gap-1">
        <%= for {filter, label} <- [
          {"all", "All"},
          {"watching", "Watching"},
          {"planning", "Planning"},
          {"completed", "Completed"},
          {"dropped", "Dropped"}
        ] do %>
          <button
            type="button"
            phx-click="filter"
            phx-value-status={filter}
            class={filter_class(filter, @filter)}
          >
            {label}
          </button>
        <% end %>
      </div>
    </div>

    <% filtered = filtered_library(@library, @filter) %>

    <%= if filtered == [] do %>
      <div class="px-4 py-10 text-center">
        <p class="text-sm font-semibold text-[var(--text)]">
          Nothing here yet.
        </p>

        <%= if @filter != "all" do %>
          <p class="mt-1 text-sm text-[var(--text-muted)]">
            You don't have any {@filter} anime.
          </p>
        <% else %>
          <p class="mt-1 text-sm text-[var(--text-muted)]">
            Add something from an anime page and it will show up here.
          </p>
        <% end %>
      </div>
    <% else %>
      <%!-- Desktop table header --%>
      <div class="hidden grid-cols-[58px_minmax(0,1fr)_120px_150px_90px] border-b border-[var(--border)] bg-[var(--surface-hover)] px-3 py-1.5 text-xs font-bold uppercase text-[var(--text-muted)] md:grid">
        <div>Cover</div>
        <div>Title</div>
        <div>Status</div>
        <div>Progress</div>
        <div class="text-right">Score</div>
      </div>

      <div class="divide-y divide-[var(--border)]">
        <%= for item <- filtered do %>
          <article class="px-3 py-3 hover:bg-[var(--surface-hover)]">
            <%!-- Desktop layout --%>
            <div class="hidden grid-cols-[58px_minmax(0,1fr)_120px_150px_90px] gap-3 md:grid">
              <%!-- Cover --%>
              <div>
                <%= if item.anime do %>
                  <.link navigate={~p"/anime/#{item.anime["id"]}"}>
                    <img
                      src={item.anime["coverImage"]["large"]}
                      alt={
                        item.anime["title"]["english"] ||
                          item.anime["title"]["romaji"]
                      }
                      class="h-20 w-14 border border-[var(--border)] object-cover"
                    />
                  </.link>
                <% else %>
                  <.link
                    navigate={~p"/anime/#{item.entry.anilist_id}"}
                    class="flex h-20 w-14 items-center justify-center border border-[var(--border)] bg-[var(--surface-hover)] text-[var(--text-muted)]"
                  >
                    ?
                  </.link>
                <% end %>
              </div>

              <%!-- Title / metadata --%>
              <div class="min-w-0 self-center">
                <%= if item.anime do %>
                  <.link
                    navigate={~p"/anime/#{item.anime["id"]}"}
                    class="block truncate text-sm font-bold text-[var(--accent)] hover:underline"
                  >
                    {item.anime["title"]["english"] || item.anime["title"]["romaji"]}
                  </.link>

                  <div class="mt-1 flex flex-wrap gap-x-3 text-xs text-[var(--text-muted)]">
                    <%= if item.anime["averageScore"] do %>
                      <span>
                        AniList:
                        <strong class="text-[var(--text)]">
                          {item.anime["averageScore"]}%
                        </strong>
                      </span>
                    <% end %>

                    <%= if item.anime["episodes"] do %>
                      <span>
                        {item.anime["episodes"]} episodes
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <.link
                    navigate={~p"/anime/#{item.entry.anilist_id}"}
                    class="text-sm font-bold text-[var(--accent)] hover:underline"
                  >
                    Anime #{item.entry.anilist_id}
                  </.link>

                  <p class="mt-1 text-xs text-[var(--text-muted)]">
                    AniList metadata unavailable
                  </p>
                <% end %>

                <%!-- Status controls --%>
                <div class="mt-2 flex flex-wrap gap-1">
                  <%= for {status, label} <- [
                    {"watching", "Watching"},
                    {"planning", "Planning"},
                    {"completed", "Completed"},
                    {"dropped", "Dropped"}
                  ] do %>
                    <button
                      type="button"
                      phx-click="set_status"
                      phx-value-id={item.entry.id}
                      phx-value-status={status}
                      class={status_button_class(status, item.entry.status)}
                    >
                      {label}
                    </button>
                  <% end %>
                </div>
              </div>

              <%!-- Current status --%>
              <div class="self-center">
                <span class={status_badge_class(item.entry.status)}>
                  {item.entry.status}
                </span>
              </div>

              <%!-- Progress --%>
              <div class="self-center">
                <div class="flex items-center justify-between gap-2 text-xs">
                  <strong class="text-[var(--text)]">
                    <%= if item.anime do %>
                      {item.entry.progress || 0}/{item.anime["episodes"] || "?"}
                    <% else %>
                      {item.entry.progress || 0}/?
                    <% end %>
                  </strong>

                  <div class="flex gap-1">
                    <button
                      type="button"
                      phx-click="decrement_progress"
                      phx-value-id={item.entry.id}
                      disabled={(item.entry.progress || 0) <= 0}
                      class="border border-[var(--border)] bg-[var(--surface)] px-2 py-0.5 font-bold hover:bg-[var(--surface-strong)] disabled:cursor-not-allowed disabled:opacity-30"
                      aria-label="Decrease progress"
                    >
                      −
                    </button>

                    <button
                      type="button"
                      phx-click="increment_progress"
                      phx-value-id={item.entry.id}
                      disabled={
                        item.anime &&
                          is_integer(item.anime["episodes"]) &&
                          (item.entry.progress || 0) >= item.anime["episodes"]
                      }
                      class="border border-[var(--button-border)] bg-[var(--accent)] px-2 py-0.5 font-bold text-white disabled:cursor-not-allowed disabled:opacity-30"
                      aria-label="Increase progress"
                    >
                      +
                    </button>
                  </div>
                </div>

                <%= if item.anime && is_integer(item.anime["episodes"]) && item.anime["episodes"] > 0 do %>
                  <progress
                    value={item.entry.progress || 0}
                    max={item.anime["episodes"]}
                    class="mt-2 block w-full"
                  >
                    {item.entry.progress || 0}
                  </progress>
                <% else %>
                  <div class="mt-2 h-[10px] border border-[var(--border)] bg-[var(--surface-strong)]">
                  </div>
                <% end %>
              </div>

              <%!-- Score --%>
              <div class="self-center text-right">
                <form phx-change="set_score">
                  <input
                    type="hidden"
                    name="entry_id"
                    value={item.entry.id}
                  />

                  <select
                    name="score"
                    class="border border-[var(--border)] bg-[var(--surface)] px-2 py-1 text-xs text-[var(--text)] outline-none focus:border-[var(--accent)]"
                  >
                    <option value="" selected={is_nil(item.entry.score)}>
                      Not rated
                    </option>

                    <%= for score <- 1..10 do %>
                      <option
                        value={score}
                        selected={item.entry.score == score}
                      >
                        {score}/10
                      </option>
                    <% end %>
                  </select>
                </form>
              </div>
            </div>

            <%!-- Mobile layout --%>
            <div class="md:hidden">
              <div class="grid grid-cols-[72px_minmax(0,1fr)] gap-3">
                <div>
                  <%= if item.anime do %>
                    <.link navigate={~p"/anime/#{item.anime["id"]}"}>
                      <img
                        src={item.anime["coverImage"]["large"]}
                        alt={
                          item.anime["title"]["english"] ||
                            item.anime["title"]["romaji"]
                        }
                        class="aspect-[2/3] w-full border border-[var(--border)] object-cover"
                      />
                    </.link>
                  <% else %>
                    <.link
                      navigate={~p"/anime/#{item.entry.anilist_id}"}
                      class="flex aspect-[2/3] w-full items-center justify-center border border-[var(--border)] bg-[var(--surface-hover)] text-[var(--text-muted)]"
                    >
                      ?
                    </.link>
                  <% end %>
                </div>

                <div class="min-w-0">
                  <%= if item.anime do %>
                    <.link
                      navigate={~p"/anime/#{item.anime["id"]}"}
                      class="block line-clamp-2 text-sm font-bold text-[var(--accent)] hover:underline"
                    >
                      {item.anime["title"]["english"] || item.anime["title"]["romaji"]}
                    </.link>
                  <% else %>
                    <.link
                      navigate={~p"/anime/#{item.entry.anilist_id}"}
                      class="text-sm font-bold text-[var(--accent)] hover:underline"
                    >
                      Anime #{item.entry.anilist_id}
                    </.link>
                  <% end %>

                  <div class="mt-1">
                    <span class={status_badge_class(item.entry.status)}>
                      {item.entry.status}
                    </span>
                  </div>

                  <%= if item.anime && item.anime["averageScore"] do %>
                    <div class="mt-1 text-xs text-[var(--text-muted)]">
                      AniList {item.anime["averageScore"]}%
                    </div>
                  <% end %>
                </div>
              </div>

              <%!-- Mobile status --%>
              <div class="mt-3 border-t border-[var(--border)] pt-2">
                <div class="mb-1 text-xs font-bold uppercase text-[var(--text-muted)]">
                  Status
                </div>

                <div class="grid grid-cols-2 gap-1">
                  <%= for {status, label} <- [
                    {"watching", "Watching"},
                    {"planning", "Planning"},
                    {"completed", "Completed"},
                    {"dropped", "Dropped"}
                  ] do %>
                    <button
                      type="button"
                      phx-click="set_status"
                      phx-value-id={item.entry.id}
                      phx-value-status={status}
                      class={status_button_class(status, item.entry.status)}
                    >
                      {label}
                    </button>
                  <% end %>
                </div>
              </div>

              <%!-- Mobile progress --%>
              <div class="mt-3 border-t border-[var(--border)] pt-2">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <span class="text-xs font-bold uppercase text-[var(--text-muted)]">
                      Progress
                    </span>

                    <strong class="ml-2 text-sm">
                      <%= if item.anime do %>
                        {item.entry.progress || 0}/{item.anime["episodes"] || "?"}
                      <% else %>
                        {item.entry.progress || 0}/?
                      <% end %>
                    </strong>
                  </div>

                  <div class="flex gap-1">
                    <button
                      type="button"
                      phx-click="decrement_progress"
                      phx-value-id={item.entry.id}
                      disabled={(item.entry.progress || 0) <= 0}
                      class="border border-[var(--border)] bg-[var(--surface)] px-3 py-1 font-bold disabled:cursor-not-allowed disabled:opacity-30"
                    >
                      −
                    </button>

                    <button
                      type="button"
                      phx-click="increment_progress"
                      phx-value-id={item.entry.id}
                      disabled={
                        item.anime &&
                          is_integer(item.anime["episodes"]) &&
                          (item.entry.progress || 0) >= item.anime["episodes"]
                      }
                      class="border border-[var(--button-border)] bg-[var(--accent)] px-3 py-1 font-bold text-white disabled:cursor-not-allowed disabled:opacity-30"
                    >
                      +
                    </button>
                  </div>
                </div>

                <%= if item.anime && is_integer(item.anime["episodes"]) && item.anime["episodes"] > 0 do %>
                  <progress
                    value={item.entry.progress || 0}
                    max={item.anime["episodes"]}
                    class="mt-2 block w-full"
                  >
                    {item.entry.progress || 0}
                  </progress>
                <% end %>
              </div>

              <%!-- Mobile score --%>
              <div class="mt-3 flex items-center justify-between border-t border-[var(--border)] pt-2">
                <span class="text-xs font-bold uppercase text-[var(--text-muted)]">
                  Your score
                </span>

                <form phx-change="set_score">
                  <input
                    type="hidden"
                    name="entry_id"
                    value={item.entry.id}
                  />

                  <select
                    name="score"
                    class="border border-[var(--border)] bg-[var(--surface)] px-2 py-1 text-sm text-[var(--text)]"
                  >
                    <option value="" selected={is_nil(item.entry.score)}>
                      Not rated
                    </option>

                    <%= for score <- 1..10 do %>
                      <option
                        value={score}
                        selected={item.entry.score == score}
                      >
                        {score}/10
                      </option>
                    <% end %>
                  </select>
                </form>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
