<main class="mx-auto max-w-7xl px-6 py-10">
  <header class="mb-10">
    <h1 class="text-4xl font-bold">Anihub</h1>
    <p class="mt-2 text-zinc-400">Trending anime</p>
  </header>

  <.search_bar />

  <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
    <%= for anime <- @anime do %>
      <.anime_card anime={anime} />
      <% end %>
  </div>
</main>