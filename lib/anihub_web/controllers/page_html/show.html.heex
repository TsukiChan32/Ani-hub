<main class="mx-auto max-w-5xl px-6 py-10">
    <a href="/" class="text-sm text-zinc-400 hover:text-white">
        ← Back
    </a>
    <div class="mt-8">
        <.search_bar />
    </div>

    <div class="mt-8 grid gap-8 md:grid-cols-[280px_1fr]">
        <img src={@anime["coverImage"]["extraLarge"]} alt={@anime["title"]["english"] || @anime["title"]["romaji"]}
            class="w-full rounded-xl" />

        <div>
            <h1 class="text-4xl font-bold">
                {@anime["title"]["english"] || @anime["title"]["romaji"]}
            </h1>

            <div class="mt-4 flex gap-4 text-zinc-400">
                <%= if @anime["averageScore"] do %>
                    <span>Score: {@anime["averageScore"]}%</span>
                    <% end %>

                        <%= if @anime["episodes"] do %>
                            <span>{@anime["episodes"]} episodes</span>
                            <% end %>

                                <%= if @anime["seasonYear"] do %>
                                    <span>{@anime["seasonYear"]}</span>
                                    <% end %>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
                <%= for genre <- @anime["genres"] do %>
                    <span class="rounded-full bg-zinc-800 px-3 py-1 text-sm">
                        {genre}
                    </span>
                    <% end %>
            </div>

            <div class="mt-8 leading-7 text-zinc-300">
                {Phoenix.HTML.raw(@anime["description"] || "No description")}
            </div>
        </div>
    </div>
</main>